# =============================================================================
# Solo Empire self-hosted stack — ENVIRONMENT TEMPLATE (LAB ONLY)
# =============================================================================
# Copy to .env and replace placeholders before `docker compose up`:
#   cp .env.example .env
#
# Rules:
# - Variable NAMES only in git. Never commit real secrets.
# - Every value below is an intentionally INVALID placeholder — replace locally.
# - This stack is for local development/learning, not production.
# - Production secrets belong in a secret manager (see infra/platform/).
# =============================================================================

# --- Core admin ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-generate-a-random-value
POSTGRES_USER=solo
POSTGRES_PASSWORD=change-me-generate-a-random-value
POSTGRES_DB=solo_empire

# --- App passwords / tokens ---
YOURLS_USER=admin
YOURLS_PASS=change-me-generate-a-random-value
VAULTWARDEN_ADMIN_TOKEN=change-me-generate-a-random-value
STEP_CA_PASSWORD=change-me-generate-a-random-value
TRIVY_SERVER_TOKEN=change-me-generate-a-random-value
WOODPECKER_AGENT_SECRET=change-me-generate-a-random-value

# --- Hoppscotch (profile: disabled by default) ---
HOPPSCOTCH_JWT_SECRET=change-me-generate-a-random-value
HOPPSCOTCH_SESSION_SECRET=change-me-generate-a-random-value
HOPPSCOTCH_GOOGLE_CLIENT_SECRET=change-me-generate-a-random-value
HOPPSCOTCH_GITHUB_CLIENT_SECRET=change-me-generate-a-random-value

# --- OAuth2 Proxy ---
# Cookie secret must be 16, 24, or 32 bytes when set for real use.
OAUTH2_PROXY_COOKIE_SECRET=change-me-generate-a-random-value
OAUTH2_PROXY_CLIENT_ID=change-me-generate-a-random-value
OAUTH2_PROXY_CLIENT_SECRET=change-me-generate-a-random-value

# --- Miniflux ---
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=change-me-generate-a-random-value

# --- InfluxDB ---
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-generate-a-random-value

# --- AI ---
OPENAI_API_KEY=change-me-generate-a-random-value

# --- BookStack ---
BOOKSTACK_MARIADB_ROOT_PASSWORD=change-me-generate-a-random-value
BOOKSTACK_DB_USER=bookstack
BOOKSTACK_DB_PASSWORD=change-me-generate-a-random-value
# Generate locally: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
BOOKSTACK_APP_KEY=base64:change-me-generate-a-random-value

# --- Umami ---
UMAMI_HASH_SALT=change-me-generate-a-random-value
UMAMI_NEXTAUTH_SECRET=change-me-generate-a-random-value

# --- imgproxy (real values are hex-encoded key material; placeholders are invalid) ---
IMGPROXY_KEY=change-me-generate-a-random-value
IMGPROXY_SALT=change-me-generate-a-random-value

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-generate-a-random-value

# --- Optional streaming lake lane ---
# The default host path resolves to ../../data/lake from this compose file.
SOLO_EMPIRE_DATA_LAKE_PATH=../../data/lake
STREAMING_TOPIC=se.events
STREAMING_RETENTION_MS=86400000
STREAMING_GROUP_ID=solo-empire-lake-sink
STREAMING_SOURCE=synthetic
STREAMING_DOMAIN=operations
STREAMING_DATASET=events
STREAMING_SCHEMA_VERSION=1
STREAMING_BATCH_SECONDS=60
STREAMING_POLL_MS=5000
STREAMING_MAX_RECORDS=1000
STREAMING_AUTO_OFFSET_RESET=earliest
STREAMING_CONVERTER_INTERVAL_SECONDS=60
ICEBERG_CATALOG_URI=sqlite:////var/lib/solo-empire/lake/catalog.db
ICEBERG_WAREHOUSE_URI=file:///var/lib/solo-empire/lake

# --- Outline (real values are long random strings; placeholders are invalid) ---
OUTLINE_SECRET_KEY=change-me-generate-a-random-value
OUTLINE_UTILS_SECRET=change-me-generate-a-random-value

# --- Firefly III ---
# Generate locally: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
FIREFLY_APP_KEY=base64:change-me-generate-a-random-value

# --- SpiceDB / Tyk ---
SPICEDB_GRPC_PRESHARED_KEY=change-me-generate-a-random-value
TYK_GW_SECRET=change-me-generate-a-random-value
