# Copy to .runtime/compose.env. Never commit the copied file.
CUSTOM_IMAGE=solo-empire-frappe
CUSTOM_TAG=16-candidate
PULL_POLICY=missing
HTTP_PUBLISH_PORT=8090
FRAPPE_SITE_NAME_HEADER=solo-empire.localhost
DB_PASSWORD=replace-with-a-local-secret
DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
