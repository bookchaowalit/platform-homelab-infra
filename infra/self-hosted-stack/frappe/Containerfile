# Keep the image base aligned with APP-LOCK.yaml and the running local stack.
FROM solo-empire-frappe:16-candidate-payments-lmsfix

USER root

# Frappe 16 calls SQLiteSearch.build_index(is_continuation=...), while the
# selected LMS release overrides the method without that compatibility
# parameter. Keep this narrow patch in the image layer until upstream LMS
# ships the matching signature.
RUN sed -i \
  -e 's/def build_index(self):/def build_index(self, is_continuation=False):/' \
  -e 's/super().build_index()/super().build_index(is_continuation=is_continuation)/' \
  /home/frappe/frappe-bench/apps/lms/lms/sqlite.py \
  && chown frappe:frappe /home/frappe/frappe-bench/apps/lms/lms/sqlite.py

# Keep the reviewed local FX guard in the candidate image. Site installation
# remains an explicit operator action; the app is not auto-installed on sites.
COPY --chown=frappe:frappe custom-apps/solo_empire_fx_guard /home/frappe/frappe-bench/apps/solo_empire_fx_guard

# Make the copied app importable to bench workers and the site installer while
# keeping provider dependencies out of the image.
RUN /home/frappe/frappe-bench/env/bin/python -m pip install --no-cache-dir --no-deps --editable \
  /home/frappe/frappe-bench/apps/solo_empire_fx_guard

USER frappe
