{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LakeConsumerListApprovedGold",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::solo-empire-portfolio",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "lake/gold/*"
          ]
        }
      }
    },
    {
      "Sid": "LakeConsumerReadApprovedGold",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::solo-empire-portfolio/lake/gold/*"
    }
  ]
}
